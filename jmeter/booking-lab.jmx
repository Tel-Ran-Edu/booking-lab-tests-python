<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BooKing Lab — local copy only"><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="TestPlan.comments">Search, booking and a race for the last room, one after another. For the local copy (docker compose) only: never run it against the cloud copy. Settings are JMeter properties (-Jname=value): host, port, protocol, cohort, rampup, search.users, search.loops, booking.users, booking.loops, race.users. See the README.</stringProp></TestPlan>
<hashTree><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="BooKing Lab API (local copy)"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,8000)}</stringProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></ConfigTestElement>
<hashTree></hashTree>
<HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cohort and JSON"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Workspace</stringProp><stringProp name="Header.value">${__P(cohort,DEMO)}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager>
<hashTree></hashTree>
<SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Setup: check the target, seed the race hotel"><stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="TestPlan.comments">Stops the whole test if the target is not the local copy or is not ready.</stringProp></SetupThreadGroup>
<hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Local copy only"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Load tests run against the local copy only (requirements: REQ-NFR-003).
def host = props.getProperty('host', 'localhost')
def allowed = ['localhost', '127.0.0.1', 'host.docker.internal']
if (!allowed.contains(host)) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("host=" + host + ": load tests may only target the local copy")
} else {
    SampleResult.setResponseData("host=" + host + " is local", "UTF-8")
}</stringProp></JSR223Sampler>
<hashTree></hashTree>
