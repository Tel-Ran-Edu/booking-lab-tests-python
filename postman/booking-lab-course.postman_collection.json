{
  "info": {
    "name": "BooKing Lab — course",
    "description": "Happy paths of the course: reviews, promo codes, favorites, the manager area and the mailbox. Run it in order (Run collection) or with Newman:\n\n    npx newman run postman/booking-lab-course.postman_collection.json -e postman/localhost.postman_environment.json\n\nEvery run creates its own test user and deletes its data at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Before every request: a stay 50–52 days from today, so dates never go stale.",
          "const day = (n) => new Date(Date.now() + n * 864e5).toISOString().slice(0, 10);",
          "pm.collectionVariables.set('check_in', day(50));",
          "pm.collectionVariables.set('check_out', day(52));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "user_password",
      "value": ""
    },
    {
      "key": "new_password",
      "value": ""
    },
    {
      "key": "check_in",
      "value": ""
    },
    {
      "key": "check_out",
      "value": ""
    },
    {
      "key": "review_hotel_id",
      "value": ""
    },
    {
      "key": "completed_booking_id",
      "value": ""
    },
    {
      "key": "review_id",
      "value": ""
    },
    {
      "key": "promo_code",
      "value": ""
    },
    {
      "key": "hotel_id",
      "value": ""
    },
    {
      "key": "room_type_id",
      "value": ""
    },
    {
      "key": "my_hotel_id",
      "value": ""
    },
    {
      "key": "to_confirm_id",
      "value": ""
    },
    {
      "key": "arriving_id",
      "value": ""
    },
    {
      "key": "new_room_type_id",
      "value": ""
    },
    {
      "key": "reset_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "description": "Wake the server, then create a verified test user for this run.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Cold start (REQ-OPS-003): the cloud copy sleeps after 15 minutes without requests. YOUR TASK: add a pre-request script here that asks /health every 5 seconds, for at most 120 seconds, before the run goes on."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('the database is up', () => pm.expect(pm.response.json().db).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/test/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "test",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "POST /test/users: a verified user with a random autotest+… email (REQ-TEST-004)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.access_token);",
                  "pm.collectionVariables.set('email', body.user.email);",
                  "pm.collectionVariables.set('user_password', body.password);",
                  "pm.collectionVariables.set('new_password', 'N3w' + Math.random().toString(36).slice(2, 8) + '!');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Reviews",
      "description": "Requirements 3.4: write a review of a completed stay, read it, edit it.",
      "item": [
        {
          "name": "Seed: a user with bookings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/test/seed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "test",
                "seed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"user_with_bookings\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "POST /test/seed creates your own hotel and one booking of yours in every status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const created = pm.response.json().created;",
                  "pm.collectionVariables.set('review_hotel_id', created.hotel_id);",
                  "pm.collectionVariables.set('completed_booking_id', created.bookings.completed);"
                ]
              }
            }
          ]
        },
        {
          "name": "Write a review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/hotels/{{review_hotel_id}}/reviews",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "hotels",
                "{{review_hotel_id}}",
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": {{completed_booking_id}},\n  \"rating\": 5,\n  \"text\": \"Quiet room, great breakfast and very friendly staff.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('matches the review schema', () => pm.response.to.have.jsonSchema({",
                  "  type: 'object',",
                  "  required: ['id', 'hotel_id', 'author', 'rating', 'text', 'created_at', 'editable_until'],",
                  "  properties: { id: { type: 'integer' }, rating: { type: 'integer', minimum: 1, maximum: 5 },",
                  "    text: { type: 'string' } },",
                  "}));",
                  "pm.test('rating 5', () => pm.expect(pm.response.json().rating).to.eql(5));",
                  "pm.collectionVariables.set('review_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "The hotel's reviews list it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/hotels/{{review_hotel_id}}/reviews",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "hotels",
                "{{review_hotel_id}}",
                "reviews"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().items.map((r) => r.id);",
                  "pm.test('my review is listed', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('review_id'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change my review",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reviews/{{review_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "reviews",
                "{{review_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A review can be changed within 24 hours of writing it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('rating is now 4', () => pm.expect(pm.response.json().rating).to.eql(4));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Promo codes",
      "description": "Requirements 3.3: check a promo code and see its discount in a quote.",
      "item": [
        {
          "name": "Seed: an active promo code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/test/seed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "test",
                "seed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"active_promo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('promo_code', pm.response.json().created.promo_code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Check the promo code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/promo-codes/{{promo_code}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "promo-codes",
                "{{promo_code}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('matches the promo schema', () => pm.response.to.have.jsonSchema({",
                  "  type: 'object', required: ['code', 'kind', 'value', 'valid_from', 'valid_to'],",
                  "  properties: { code: { type: 'string' }, kind: { type: 'string' } },",
                  "}));",
                  "pm.test('the same code', () => pm.expect(pm.response.json().code).to.eql(pm.collectionVariables.get('promo_code')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find a room for the quote",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/hotels?city=Jerusalem&check_in={{check_in}}&check_out={{check_out}}&adults=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Jerusalem"
                },
                {
                  "key": "check_in",
                  "value": "{{check_in}}"
                },
                {
                  "key": "check_out",
                  "value": "{{check_out}}"
                },
                {
                  "key": "adults",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const hotel = pm.response.json().items[0];",
                  "pm.test('a hotel has free rooms', () => pm.expect(hotel).to.be.an('object'));",
                  "pm.collectionVariables.set('hotel_id', hotel.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Room types of that hotel",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/hotels/{{hotel_id}}/availability?check_in={{check_in}}&check_out={{check_out}}&adults=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "hotels",
                "{{hotel_id}}",
                "availability"
              ],
              "query": [
                {
                  "key": "check_in",
                  "value": "{{check_in}}"
                },
                {
                  "key": "check_out",
                  "value": "{{check_out}}"
                },
                {
                  "key": "adults",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const room = pm.response.json().room_types.find((r) => r.free_rooms > 0 && r.fits_guests);",
                  "pm.test('a room type fits two adults', () => pm.expect(room).to.be.an('object'));",
                  "pm.collectionVariables.set('room_type_id', room.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Quote with the promo code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/quote",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "quote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_type_id\": {{room_type_id}},\n  \"check_in\": \"{{check_in}}\",\n  \"check_out\": \"{{check_out}}\",\n  \"adults\": 2,\n  \"promo_code\": \"{{promo_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('matches the quote schema', () => pm.response.to.have.jsonSchema({",
                  "  type: 'object', required: ['subtotal', 'discount', 'tax', 'total', 'currency'],",
                  "  properties: { subtotal: { type: 'string', pattern: '^-?\\\\d+\\\\.\\\\d{2}$' }, discount: { type: 'string', pattern: '^-?\\\\d+\\\\.\\\\d{2}$' }, tax: { type: 'string', pattern: '^-?\\\\d+\\\\.\\\\d{2}$' }, total: { type: 'string', pattern: '^-?\\\\d+\\\\.\\\\d{2}$' } },",
                  "}));",
                  "pm.test('the promo code gives a discount', () => pm.expect(Number(pm.response.json().discount)).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 Favorites",
      "description": "Requirements 3.2: save a hotel, see it in favorites, remove it.",
      "item": [
        {
          "name": "Add the hotel to favorites",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/favorites/{{hotel_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "favorites",
                "{{hotel_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Favorites list it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/favorites",
