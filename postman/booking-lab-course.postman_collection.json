              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/favorites/{{hotel_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "favorites",
                "{{hotel_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Favorites no longer list it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/favorites",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "favorites"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().items.map((h) => h.id);",
                  "pm.test('the hotel is gone', () => pm.expect(ids).to.not.include(Number(pm.collectionVariables.get('hotel_id'))));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 Manager area",
      "description": "Requirements 3.5: a manager's hotel, room types, prices, bookings and reports.",
      "item": [
        {
          "name": "Seed: a manager with a hotel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/test/seed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "test",
                "seed"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"manager_with_hotel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Makes you a manager with your own hotel, a booking to confirm and a guest arriving today."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const created = pm.response.json().created;",
                  "pm.collectionVariables.set('my_hotel_id', created.hotel_id);",
                  "pm.collectionVariables.set('to_confirm_id', created.bookings.to_confirm);",
                  "pm.collectionVariables.set('arriving_id', created.bookings.arriving_today);"
                ]
              }
            }
          ]
        },
        {
          "name": "My hotels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace",
                "value": "{{cohort}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/manager/hotels",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "manager",
                "hotels"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
